# Server Configuration
PORT=3000
NODE_ENV=development

# LLM Configuration
# Modes: "mock" (default, zero setup needed) | "openai" | "gemini"
LLM_PROVIDER=mock

# Real LLM API Keys (optional - leave empty to use deterministic mock engine)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# SQLite Database
DATABASE_PATH=./data/erp_system.db
