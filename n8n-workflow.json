{
  "name": "ERP Support & Agent Escalation Pipeline",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "support-ticket",
        "options": {}
      },
      "id": "11111111-1111-1111-1111-111111111111",
      "name": "Webhook Ingestion",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [240, 300],
      "webhookId": "9b12a32c-7b56-42d8-9189-9a2c10b77e81"
    },
    {
      "parameters": {
        "url": "http://localhost:3000/api/webhook/n8n/support-ticket",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"event\": \"customer_support_request\",\n  \"customerQuery\": {{$json.body.customerQuery || $json.body.query}},\n  \"source\": \"N8N_WEBHOOK\",\n  \"externalTicketId\": {{$json.body.ticketId || 'N8N-AUTO'}}\n}",
        "options": {}
      },
      "id": "22222222-2222-2222-2222-222222222222",
      "name": "Invoke ERP Support Agent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [480, 300]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{$json.needsHumanReview}}",
              "value2": true
            }
          ]
        }
      },
      "id": "33333333-3333-3333-3333-333333333333",
      "name": "Is 2nd Level Escalated?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [720, 300]
    },
    {
      "parameters": {
        "content": "⚠️ *2nd-Level ERP Escalation Alert*\n*Ticket ID:* {{$json.escalationTicketId}}\n*Proposed SQL Patch:*\n```sql\n{{$json.suggestedSqlPatch}}\n```\n*Analysis:*\n{{$json.finalAnswer}}"
      },
      "id": "44444444-4444-4444-4444-444444444444",
      "name": "Alert DevOps & DBA on Slack",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.1,
      "position": [960, 200]
    },
    {
      "parameters": {
        "content": "✅ *1st-Level Auto-Resolved*\n{{$json.finalAnswer}}"
      },
      "id": "55555555-5555-5555-5555-555555555555",
      "name": "Send Customer Auto-Reply",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [960, 400]
    }
  ],
  "connections": {
    "Webhook Ingestion": {
      "main": [
        [
          {
            "node": "Invoke ERP Support Agent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Invoke ERP Support Agent": {
      "main": [
        [
          {
            "node": "Is 2nd Level Escalated?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Is 2nd Level Escalated?": {
      "main": [
        [
          {
            "node": "Alert DevOps & DBA on Slack",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Send Customer Auto-Reply",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
